{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@supabase/supabase-js": [
        "./tests/security/node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "*.ts",
    "../../lib/push-subscription-cleanup.ts",
    "../../lib/list-pagination.ts",
    "../../lib/feed-query.ts",
    "../../lib/form-state.ts",
    "../../lib/account-deletion.ts"
  ]
}
